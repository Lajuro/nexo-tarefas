#!/usr/bin/env bash
# =============================================================================
#  .githooks/pre-push · não deixa a main ir para o GitHub com os scripts de
#  cópia velhos (scripts/baixar-nexo.sh e scripts/nexo-offline.sh).
#
#  Ligar, uma vez em cada cópia do repositório:
#    git config core.hooksPath .githooks
#
#  Se barrar: bash scripts/gerar-scripts-de-copia.sh --commit  e  git push de novo.
#  Só em emergência: git push --no-verify (e gere os scripts logo depois).
# =============================================================================
set -uo pipefail

raiz="$(git rev-parse --show-toplevel)" || exit 0
gerador="$raiz/scripts/gerar-scripts-de-copia.sh"
[ -f "$gerador" ] || exit 0

barrou=0
while read -r _ref_local sha_local ref_remota _sha_remoto; do
  [ "$ref_remota" = "refs/heads/main" ] || continue
  case "$sha_local" in *[!0]*) ;; *) continue ;; esac # apagando a branch
  if ! bash "$gerador" --check "$sha_local"; then
    barrou=1
  fi
done

if [ "$barrou" = 1 ]; then
  printf '  Push para a main cancelado pelo .githooks/pre-push.\n\n' >&2
  exit 1
fi
exit 0
